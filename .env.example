# Optional read-only "server wordlists" library — lets the frontend offer a
# searchable dropdown of files next to each upload button, instead of only
# drag-and-drop / browser file picker. Feature is off unless both are set.
# Copy this file to `.env` and fill in a real path to turn it on.
#
# Under `docker compose up`, NARWAL_WORDLISTS_DIR is a HOST path — it gets
# bind-mounted read-only into the container (see docker-compose.yml). With
# bare `uvicorn` (no Docker), it's read directly, so use a local path there.
NARWAL_WORDLISTS_DIR=

# Regex (Python re.search) a file's path — relative to NARWAL_WORDLISTS_DIR,
# forward slashes — must match to be listed. Empty matches everything under
# the directory. Example: mount_path=/usr/share/dict with the regex below
# surfaces files under /usr/share/dict/hashmob/cleaned/ and
# /usr/share/dict/rockyou/cleaned/.
#
# This is a real boundary, not just a UI filter: a mergeability job may only
# reference files that match it, so tightening the regex also narrows what
# jobs can run against.
# NARWAL_WORDLISTS_REGEX=(hashmob|rockyou)/cleaned/.*
NARWAL_WORDLISTS_REGEX=


# ── Mergeability worker ─────────────────────────────────────────────────────
# The Mergeability scene queues jobs that a hashcat worker container runs in
# the background. Everything below is optional and has a working default; the
# scene needs NARWAL_WORDLISTS_DIR above to be set, since its goal list and
# attack wordlists have to be files the server can already see.

# Where the job queue (narwal.db) and per-job hashcat artifacts are written.
# The one read-write directory the app uses. Defaults to ./runs at the repo
# root, bind-mounted into both containers.
# NARWAL_RUNS_HOST_DIR=./runs

# Directory a job's rule files must live under. Defaults to hashcat's own
# /usr/share/hashcat/rules, which the worker image already ships.
# NARWAL_RULES_DIR=/usr/share/hashcat/rules

# Pass --force to hashcat. Needed when the only OpenCL device is a PoCL CPU
# runtime, which hashcat refuses to use ("No devices found/left") without it —
# that is the default CPU-only setup, so compose turns this on. Set it empty
# when running against a real GPU, where those warnings are worth heeding.
# NARWAL_HASHCAT_FORCE=1

# Extra hashcat arguments appended to every run, shell-split. Operator config
# only — never reachable from the API. e.g. `-d 2` to pin a device.
# NARWAL_HASHCAT_EXTRA=

# Seconds without a heartbeat before a running job is assumed abandoned and
# requeued for a clean re-run. Covers a killed or restarted worker.
# NARWAL_WORKER_STALE=120
# NARWAL_WORKER_POLL=2
